#!/bin/bash
set -euo pipefail

VERSION="${1}"
ARTIFACT="${2}"

#
# Download and install the base artifact
#
mkdir -p "${VERSION}"
curl -fsSL "${ARTIFACT}" | tar --strip-components=1 --no-same-owner -C "${VERSION}" -xzvf -

#
# Remove the toolchain's own regression tests and API compatibility listings:
# building, testing and vetting Go code doesn't use them
#
rm -rf "${VERSION}/test" "${VERSION}/api"

#
# Create the links for the remaining versions
#
P="${VERSION}"
N=""
while true ; do
	N="${P%.*}"
	[ "${P}" == "${N}" ] && break

	# Remove competing links
	[ -h "${N}" ] && rm -f "${N}"

	ln -sv "${P}" "${N}"
	P="${N}"
done
