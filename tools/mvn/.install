#!/bin/bash
set -euo pipefail

VERSION="${1}"
ARTIFACT="${2}"

mkdir -p "${VERSION}"
curl -fsSL "${ARTIFACT}" | tar --strip-components=1 --no-same-owner -C "${VERSION}" -xzvf -

P="${VERSION}"
N=""
while true ; do
	N="${P%.*}"
	[ "${P}" == "${N}" ] && break

	# Remove competing links
	[ -h "${N}" ] && rm -f "${N}"

	ln -sv "${P}" "${N}"
	P="${N}"
done
