#!/bin/bash
set -euo pipefail

VERSION="${1}"
ARTIFACT="${2}"

#
# Download and install the base artifact
#
mkdir -p "${VERSION}"
curl -fsSL "${ARTIFACT}" | tar --strip-components=1 --no-same-owner -C "${VERSION}" -xJvf -

#
# Remove the C/C++ headers: they're only for building native addons, and
# node-gyp downloads the ones it needs instead of using these
#
rm -rf "${VERSION}/include"

#
# Create the links for the remaining versions
#
P="${VERSION}"
N=""
while true ; do
	N="${P%.*}"
	[ "${P}" == "${N}" ] && break

	# Remove competing links
	[ -h "${N}" ] && rm -f "${N}"

	ln -sv "${P}" "${N}"
	P="${N}"
done
